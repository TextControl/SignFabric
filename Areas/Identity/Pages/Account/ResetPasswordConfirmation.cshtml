@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password reset";
}

<section id="home" class="container section auth-section">
    <div class="auth-card">
        <div class="auth-icon" aria-hidden="true">
            <i class="bi bi-check2"></i>
        </div>
        <h1>@ViewData["Title"]</h1>
        <p>Your password has been reset. You can sign in with the new password now.</p>

        <div class="auth-link">
            <a asp-page="./Login">Back to login</a>
        </div>
    </div>
</section>
