@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section id="home" class="container section auth-section">
    <div class="auth-card auth-card-wide">
        <div class="auth-icon" aria-hidden="true">
            <i class="bi bi-person-plus"></i>
        </div>
        <h1>@ViewData["Title"]</h1>
        <p>Create your SignFabric account.</p>

        @if (Model.BootstrapAdminConfigured) {
            <div class="alert alert-info text-start" role="alert">
                The initial administrator account is controlled by application configuration.
            </div>
        }

        <form asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6 mb-3 text-start">
                    <label class="form-label" asp-for="Input.FirstName"></label>
                    <input autocomplete="given-name" asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3 text-start">
                    <label class="form-label" asp-for="Input.LastName"></label>
                    <input autocomplete="family-name" asp-for="Input.LastName" class="form-control" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3 text-start">
                <label class="form-label" asp-for="Input.Email">E-Mail</label>
                <input autocomplete="username" asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3 text-start">
                <label class="form-label" asp-for="Input.Password"></label>
                <input autocomplete="new-password" asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="mb-3 text-start">
                <label class="form-label" asp-for="Input.ConfirmPassword"></label>
                <input autocomplete="new-password" asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary auth-submit">Register</button>
        </form>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</section>
