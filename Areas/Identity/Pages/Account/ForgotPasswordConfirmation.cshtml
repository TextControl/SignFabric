@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Check your e-mail";
}

<section id="home" class="container section auth-section">
    <div class="auth-card">
        <div class="auth-icon" aria-hidden="true">
            <i class="bi bi-envelope-check"></i>
        </div>
        <h1>@ViewData["Title"]</h1>
        <p>If an account exists for that e-mail address, a reset link has been sent.</p>

        <div class="auth-link">
            <a asp-page="./Login">Back to login</a>
        </div>
    </div>
</section>
