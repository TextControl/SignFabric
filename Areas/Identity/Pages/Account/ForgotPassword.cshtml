@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot password";
}

<section id="home" class="container section auth-section">
    <div class="auth-card">
        <div class="auth-icon" aria-hidden="true">
            <i class="bi bi-key"></i>
        </div>
        <h1>@ViewData["Title"]</h1>
        <p>Enter your e-mail address and we will send a reset link.</p>

        <form method="post" class="auth-form">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3 text-start">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary auth-submit">Send Reset Link</button>
            <div class="auth-link">
                <a asp-page="./Login">Back to login</a>
            </div>
        </form>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</section>
