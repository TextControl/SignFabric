@model SignModel
@using TXTextControl.Web.MVC


<div class="editor-close">
    <button data-esign-action="save-editor-document" class="btn btn-warning" title="Save the prepared document and return to the envelope workflow">
        <strong>Done Editing</strong>
    </button>
</div>

<div class="editor-wrapper">
    <aside class="sidebar editor-sidebar" aria-label="Envelope field tools">

        <div class="list-group">

            <h5 class="editor-sidebar-title">Recipient Signature</h5>
            <p class="editor-sidebar-help">Place the cursor where the signer should sign, then click a recipient.</p>

            @{
                foreach (Signer signer in Model.Envelope.Signers.Where(signer => signer.Role == RecipientRole.Signer)) {
                    <div id="txsign_@signer.Id" class="list-group-item toolbox-item toolbox-item-small toolbox-item-signature">
                        <span class="toolbox-item-main">
                            <i class="bi bi-pen-fill" aria-hidden="true"></i>
                            <span class="toolbox-item-label">@signer.Email</span>
                        </span>
                        <span class="toolbox-item-actions signature-recipient-actions">
                            <button type="button"
                                    data-esign-action="insert-text-frame"
                                    data-signer-id="@signer.Id"
                                    data-signer-name="@signer.Name"
                                    class="btn btn-sm btn-warning"
                                    data-placement-hint="Signature field added. Move the cursor and click another recipient to add more signatures.">
                                Place
                            </button>
                            <button type="button"
                                    data-esign-action="assign-selected-signature-field"
                                    data-signer-id="@signer.Id"
                                    class="btn btn-sm btn-outline-primary"
                                    data-placement-hint="Selected signature field assigned to this recipient.">
                                Assign
                            </button>
                        </span>
                    </div>
                }
            }

            <button type="button" data-esign-action="open-signature-area-wizard" class="btn btn-outline-secondary w-100 mt-3" data-placement-hint="Signature area inserted at the cursor for the selected recipient configuration.">
                <i class="bi bi-layout-text-window-reverse" aria-hidden="true"></i>
                Insert Signature Area
            </button>
            <p class="editor-sidebar-help mt-2">Insert a structured signature block with signature, signer name, and date.</p>

            @*@{ if (Model.Envelope.Signers.Count == 1) {*@
                <h5 class="editor-sidebar-section-title mt-4">Recipient Fields</h5>
                <p class="editor-sidebar-help">Choose who owns the next field, place the cursor, then click a field.</p>

                <div id="fieldPlacementHint" class="field-placement-hint" role="status" aria-live="polite">
                    Place the cursor in the document, then click a field to insert it.
                </div>

                <label for="formOwner" class="form-label editor-sidebar-label">Assign fields to</label>
                <select id="formOwner" class="form-select mb-3">
                    @foreach (Signer signer in Model.Envelope.Signers.Where(signer => signer.Role == RecipientRole.Signer)) {
                    <option value="@signer.Id">@signer.Email</option>
                    }
                </select>

                @await Html.PartialAsync("~/Pages/Shared/EditorPartials/_RecipientFieldGroups.cshtml", null, new ViewDataDictionary(ViewData) {
                    ["FieldGroupsId"] = "recipientFieldGroups",
                    ["ShowTemplateMergeFields"] = false
                })

               @*}
            }*@
        </div>

        <div id="fieldProperties" class="d-none">
            <h5>Field Properties</h5>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="fieldRequired">
                <label class="form-check-label" for="fieldRequired">Required field</label>
            </div>
        </div>

    </aside>
    <div class="editor-document no-tabs">
        @Html.TXTextControl().TextControl(settings => {
            settings.Dock = TXTextControl.Web.DockStyle.Fill;
        }).Render()
    </div>
</div>

<div class="modal fade" id="signatureAreaWizardModal" tabindex="-1" aria-labelledby="signatureAreaWizardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-modal-content">
            <div class="modal-header app-modal-header">
                <div class="app-modal-icon" aria-hidden="true">
                    <i class="bi bi-layout-text-window-reverse"></i>
                </div>
                <h5 class="modal-title" id="signatureAreaWizardModalLabel">Insert Signature Area</h5>
                <p>Create a structured signature block with signer details and one or more signature fields.</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body app-modal-body">
                <div class="mb-3">
                    <label class="form-label d-block">Recipients</label>
                    <div id="signatureAreaSignerList" class="field-assignment-list">
                        @foreach (var signer in Model.Envelope.Signers.Where(signer => signer.Role == RecipientRole.Signer)) {
                            <label class="field-assignment-row mb-0">
                                <span class="field-assignment-label">
                                    <input class="form-check-input me-2 signature-area-signer" type="checkbox" name="signatureAreaSignerIds" value="@signer.Id" checked>
                                    <span>
                                        <strong>@(string.IsNullOrWhiteSpace(signer.Name) ? signer.Email : signer.Name)</strong><br />
                                        <span class="text-muted">@signer.Email</span>
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Included fields</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="signatureAreaIncludeSignerName" checked>
                        <label class="form-check-label" for="signatureAreaIncludeSignerName">Signer name</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="signatureAreaIncludeDate" checked>
                        <label class="form-check-label" for="signatureAreaIncludeDate">Current date</label>
                    </div>
                </div>

                <div class="form-text">The signature area is inserted as a table at the current cursor position.</div>
            </div>
            <div class="modal-footer app-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" data-esign-action="insert-signature-area">
                    <strong>Insert Signature Area</strong>
                </button>
            </div>
        </div>
    </div>
</div>

<div data-esign-init="envelope-editor" data-envelope-id="@Model.Envelope.EnvelopeID"></div>

