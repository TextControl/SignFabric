@model SignModel
@using TXTextControl.Web.MVC

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 5">
    <div id="liveToast" class="toast hide text-white bg-success" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <i class="bi bi-clipboard-check" aria-hidden="true"></i>&nbsp;
            <strong class="me-auto">Text Control eSign</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div id="liveToastMessage" class="toast-body">

        </div>
    </div>
</div>

<div class="editor-close">
    <button data-esign-action="save-editor-document" class="btn btn-warning"><strong>Save and Close</strong></button>
</div>

<div class="editor-wrapper">
    <div class="sidebar">

        <div class="list-group">

            <h5>Signature Fields</h5>

            @{
                foreach (Signer signer in Model.Envelope.Signers) {
                    <a id="txsign_@signer.Id" data-esign-action="insert-text-frame" data-signer-id="@signer.Id" data-signer-name="@signer.Name" class="list-group-item list-group-item-action toolbox-item toolbox-item-small">
                        <i class="bi bi-pen-fill" aria-hidden="true"></i> @signer.Email
                    </a>
                }
            }

            @*@{ if (Model.Envelope.Signers.Count == 1) {*@
                <h5 class="mt-4">Form Fields</h5>

                <select id="formOwner" class="form-select mb-2">
                    @foreach (Signer signer in Model.Envelope.Signers) {
                    <option value="@signer.Id">@signer.Email</option>
                    }
                </select>

                <a data-esign-action="insert-text-form-field" class="list-group-item list-group-item-action toolbox-item ">
                    <i class="bi bi-input-cursor-text" aria-hidden="true"></i> Text Form Field
                </a>
                <a data-esign-action="insert-checkbox" class="list-group-item list-group-item-action toolbox-item">
                    <i class="bi bi-check-square" aria-hidden="true"></i> Checkbox
                </a>
                <a data-esign-action="insert-dropdown" class="list-group-item list-group-item-action toolbox-item">
                    <i class="bi bi-menu-button-wide" aria-hidden="true"></i> Drop-Down
                </a>
                <a data-esign-action="insert-date-picker" class="list-group-item list-group-item-action toolbox-item">
                    <i class="bi bi-calendar-date" aria-hidden="true"></i> Date Picker
                </a>

               @*}
            }*@
        </div>

        <div id="fieldProperties" class="d-none">
            <h5>Field Properties</h5>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="fieldRequired">
                <label class="form-check-label" for="fieldRequired">Required field</label>
            </div>
        </div>

    </div>
    <div class="editor-document no-tabs">
        @Html.TXTextControl().TextControl(settings => {
            settings.Dock = TXTextControl.Web.DockStyle.Fill;
        }).Render()
    </div>
</div>

<div data-esign-init="envelope-editor" data-envelope-id="@Model.Envelope.EnvelopeID"></div>

