@model ContractEditModel
@using TXTextControl.Web.MVC

<div class="editor-close">
    <button data-esign-action="save-editor-document" class="btn btn-warning" title="Save the contract and return to the workflow">
        <strong>Done Editing</strong>
    </button>
</div>

<div class="editor-wrapper">
    <aside class="sidebar editor-sidebar" aria-label="Contract field tools">

        <div class="list-group">

            <h5 class="editor-sidebar-title">Recipient Signature</h5>
            <p class="editor-sidebar-help">Place the cursor where a signer should sign, then add a signature box.</p>

            <a data-esign-action="insert-text-frame" class="list-group-item list-group-item-action toolbox-item toolbox-item-signature mb-3" data-placement-hint="Signature box added at the cursor.">
                <span class="toolbox-item-main">
                    <i class="bi bi-pen-fill" aria-hidden="true"></i>
                    <span class="toolbox-item-label">Signature Box</span>
                </span>
                <span class="toolbox-item-action">Click to place</span>
            </a>

            <h5 class="editor-sidebar-section-title mt-4">Recipient Fields</h5>
            <p class="editor-sidebar-help">Place the cursor, then click the data or field type to insert.</p>

            <div id="fieldPlacementHint" class="field-placement-hint" role="status" aria-live="polite">
                Place the cursor in the document, then click a field to insert it.
            </div>

            @await Html.PartialAsync("~/Pages/Shared/EditorPartials/_RecipientFieldGroups.cshtml", null, new ViewDataDictionary(ViewData) {
                ["FieldGroupsId"] = "contractFieldGroups",
                ["ShowTemplateMergeFields"] = true
            })
        </div>

        <div id="fieldProperties" class="d-none">
            <h5>Field Properties</h5>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="fieldRequired">
                <label class="form-check-label" for="fieldRequired">Required field</label>
            </div>
            <div class="mt-2">
                <label for="fieldName" class="form-label">Field name</label>
                <div class="input-group">
                    <input type="text" required placeholder="Add field name" class="form-control" id="fieldName" aria-describedby="fieldNameHelp">
                    <button class="btn btn-outline-secondary" type="button" id="fieldNameApply">Apply</button>
                </div>
                <div id="fieldNameHelp" class="form-text">Unique name of the field.</div>
            </div>
        </div>

    </aside>
    <div class="editor-document">
        @Html.TXTextControl().TextControl(settings => {
            settings.Dock = TXTextControl.Web.DockStyle.Fill;
        }).Render()
    </div>
</div>

<div data-esign-init="contract-editor" data-contract-id="@Model.Contract.ContractID"></div>
