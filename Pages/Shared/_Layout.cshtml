@using Microsoft.AspNetCore.Identity
@using SignFabric.Application.Abstractions
@inject SignInManager<LiteDB.Identity.Models.LiteDbUser> SignInManager
@inject ICertificateManagementService CertificateManagementService

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isSignerAccount = User.IsInRole(SignFabric.Application.Identity.AppRoles.Signer);
    var canRequestSignatures = (!isSignedIn || CertificateManagementService.HasActiveSigningCertificate()) && !isSignerAccount;
    var newMenuTitle = canRequestSignatures
        ? "Create a new signature request"
        : "A signing certificate is required before signatures can be requested.";
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isReviewSignPage = string.Equals(currentPath, "/review", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/review/sign", StringComparison.OrdinalIgnoreCase);
    var isReviewValidatePage = currentPath.StartsWith("/review/validate", StringComparison.OrdinalIgnoreCase);
    var firstName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    var lastName = User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value;
    var signedInDisplayName = string.Join(" ", new[] { firstName, lastName }.Where(value => !string.IsNullOrWhiteSpace(value)));
    if (string.IsNullOrWhiteSpace(signedInDisplayName)) {
        signedInDisplayName = User.Identity?.Name;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Text Control SignFabric</title>
    <meta name="description" content="Manage electronic signature workflows, templates, contracts, and signed documents.">
    <meta name="color-scheme" content="light dark" />
    <script>
        (function () {
            var storedTheme = localStorage.getItem("signfabric-theme");
            var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            var theme = storedTheme || (prefersDark ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <link href="~/twitter-bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.min.css" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
</head>
<body>

    <header>
        <nav class="navbar fixed-top navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <img class="signfabric-logo signfabric-logo-light" src="~/images/signfabric.svg" width="200" alt="Text Control SignFabric" />
                    <img class="signfabric-logo signfabric-logo-dark" src="~/images/signfabric_darkmode.svg" width="200" alt="Text Control SignFabric" />
                </a>
                <button class="navbar-toggler signfabric-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="signfabric-menu-toggle-lines" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <div class="mobile-menu-header">
                        <button class="mobile-menu-close" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-label="Close navigation">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                        <div class="mobile-menu-title">Menu</div>
                    </div>
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (!isSignerAccount) {
                            <li class="nav-item @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("/New/") == true ? "active" : "")">
                                @if (canRequestSignatures) {
                                    <a class="nav-link" href="/new" title="@newMenuTitle"><i class="bi bi-send nav-link-icon" aria-hidden="true"></i>New</a>
                                }
                                else {
                                    <span class="nav-link disabled" aria-disabled="true" title="@newMenuTitle"><i class="bi bi-send nav-link-icon" aria-hidden="true"></i>New</span>
                                }
                            </li>
                        }

                        @if (isSignedIn)
                        {

                            <li class="nav-item @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("/Envelopes/") == true ? "active" : "")">
                                <a class="nav-link" href="/envelopes"><i class="bi bi-pen nav-link-icon" aria-hidden="true"></i>@(isSignerAccount ? "Documents" : "Signatures")</a>
                            </li>
                            @if (!isSignerAccount) {
                                <li class="nav-item @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("/Contracts/") == true ? "active" : "")">
                                    <a class="nav-link" href="/contracts"><i class="bi bi-file-earmark-text nav-link-icon" aria-hidden="true"></i>Contracts</a>
                                </li>
                                <li class="nav-item @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("/Templates/") == true ? "active" : "")">
                                    <a class="nav-link" href="/templates"><i class="bi bi-layers nav-link-icon" aria-hidden="true"></i>Templates</a>
                                </li>
                            }
                            @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                                <li class="nav-item @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("/Admin/") == true ? "active" : "")">
                                    <a class="nav-link" href="/admin"><i class="bi bi-sliders nav-link-icon" aria-hidden="true"></i>Admin</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav d-flex">
                        <li class="nav-item @(isReviewSignPage ? "active" : "")">
                            <a class="nav-link" href="/review">
                                <i class="bi bi-vector-pen nav-link-icon" aria-hidden="true"></i>

                                <span class="d-none d-xl-block">Sign a Document</span>
                                <span class="d-xl-none">Sign</span>

                            </a>
                        </li>
                        <li class="nav-item @(isReviewValidatePage ? "active" : "")">
                            <a class="nav-link" href="/review/validate">
                                <i class="bi bi-shield-check nav-link-icon" aria-hidden="true"></i>

                                <span class="d-none d-xl-block">Validate a Document</span>
                                <span class="d-xl-none">Validate</span>

                            </a>
                        </li>
                    </ul>
                    <div class="d-flex navbar-account">
                        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">
                            <i class="bi bi-moon-stars" aria-hidden="true"></i>
                            <span class="theme-toggle-label">Dark</span>
                        </button>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="footer signfabric-footer">
        <div class="signfabric-footer-shell">
            <div class="signfabric-footer-brand">
                <a href="/" aria-label="Text Control SignFabric home">
                    <img class="signfabric-logo signfabric-logo-light" src="~/images/signfabric.svg" alt="Text Control SignFabric" />
                    <img class="signfabric-logo signfabric-logo-dark" src="~/images/signfabric_darkmode.svg" alt="Text Control SignFabric" />
                </a>
                <span>&copy; @DateTime.Now.Year Text Control. All rights reserved.</span>
            </div>

            <div class="signfabric-footer-actions">
                @if (isSignedIn && !string.IsNullOrWhiteSpace(signedInDisplayName)) {
                    <a class="signfabric-footer-user" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage profile">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        <span>Signed in as <strong>@signedInDisplayName</strong></span>
                    </a>
                }

                <nav class="signfabric-footer-nav" aria-label="Footer shortcuts">
                    @if (!isSignerAccount) {
                        @if (canRequestSignatures) {
                            <a href="/new">New Envelope</a>
                        }
                        else {
                            <span aria-disabled="true" title="@newMenuTitle">New Envelope</span>
                        }
                    }
                    @if (isSignedIn) {
                        <a href="/envelopes">@(isSignerAccount ? "Documents" : "Signatures")</a>
                        @if (!isSignerAccount) {
                            <a href="/templates">Templates</a>
                        }
                        @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                            <a href="/admin">Admin</a>
                        }
                    }
                    <a href="/review/validate">Validate</a>
                </nav>
            </div>
        </div>
    </footer>
    <script src="~/twitter-bootstrap/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
