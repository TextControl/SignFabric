@using Microsoft.AspNetCore.Identity
@inject SignInManager<LiteDB.Identity.Models.LiteDbUser> SignInManager
@inject UserManager<LiteDB.Identity.Models.LiteDbUser> UserManager

@if (SignInManager.IsSignedIn(User)) {
<ul class="navbar-nav d-flex">
    <li class="nav-item identity">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <i class="bi bi-person-circle" aria-hidden="true"></i>
            <span class="identity-label">Profile</span>
        </a>
    </li>
    <li class="nav-item identity">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Logout">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            <span class="identity-label">Log out</span>
        </a>
    </li>
</ul>
}
else {
<ul class="navbar-nav d-flex">
    <li class="nav-item identity">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
            <span class="identity-label">Register</span>
        </a>
    </li>
    <li class="nav-item identity">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            <span class="identity-label">Log in</span>
        </a>
    </li>
</ul>
}
