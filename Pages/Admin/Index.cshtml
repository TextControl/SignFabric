                    <span asp-validation-for="AuthenticationSettings.OpenIdConnectResponseType" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="AuthenticationSettings.OpenIdConnectAuthority" class="form-label"></label>
