@page "/admin"
@model SignFabric.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Admin";
    var hasAzureKeyVaultCertificate = Model.CertificateConfiguration.Provider == "AzureKeyVault"
        && !string.IsNullOrWhiteSpace(Model.CertificateConfiguration.AzureKeyVaultUri)
        && !string.IsNullOrWhiteSpace(Model.CertificateConfiguration.AzureCertificateName);
    var hasActiveLocalCertificate = Model.Certificates.Any(certificate => certificate.IsActive);
    var hasSigningCertificate = hasAzureKeyVaultCertificate || hasActiveLocalCertificate;
    var activeAdminTab = Request.Query.ContainsKey("emailTemplate")
        ? "email"
        : Model.ActiveAdminTab == "email" || Model.ActiveAdminTab == "auth" || Model.ActiveAdminTab == "certificates" || Model.ActiveAdminTab == "users"
            ? Model.ActiveAdminTab
            : "users";
    var certificatesTabActive = activeAdminTab == "certificates";
    var emailTabActive = activeAdminTab == "email";
    var authTabActive = activeAdminTab == "auth";
    var usersTabActive = activeAdminTab == "users";
}

<section id="home" class="container section">
    <h1>Admin</h1>
    <p>Manage users, roles, invitations, and application settings.</p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage)) {
        <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
    }

    @if (!hasSigningCertificate) {
        <div class="alert alert-warning certificate-required-alert mt-4" role="alert">
            <strong>No signing certificate is configured.</strong>
            <p class="mb-0 mt-2">
                Add and set a default local PFX certificate or configure Azure Key Vault before users can request signatures.
            </p>
        </div>
    }

    @if (Model.EmailSettings.PasswordRequiresReset) {
        <div class="alert alert-warning certificate-required-alert mt-4" role="alert">
            <strong>The stored SMTP password must be re-entered.</strong>
            <p class="mb-0 mt-2">
                The application identity changed and the old encrypted SMTP password can no longer be decrypted. Re-enter the SMTP password in E-Mail Settings.
            </p>
        </div>
    }
    else if (!Model.HasEmailCredentials) {
        <div class="alert alert-warning certificate-required-alert mt-4" role="alert">
            <strong>No e-mail credentials are configured.</strong>
            <p class="mb-0 mt-2">
                Add SMTP server, sender address, username, and password before the application can send invitations, access codes, and signing notifications.
            </p>
        </div>
    }

    <div class="admin-tabs mt-4">
        <ul class="nav nav-tabs" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(usersTabActive ? "active" : null)" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-panel" type="button" role="tab" aria-controls="users-panel" aria-selected="@(usersTabActive.ToString().ToLower())">
                    User Management
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(emailTabActive ? "active" : null)" id="email-tab" data-bs-toggle="tab" data-bs-target="#email-panel" type="button" role="tab" aria-controls="email-panel" aria-selected="@(emailTabActive.ToString().ToLower())">
                    E-Mail Settings
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(authTabActive ? "active" : null)" id="auth-tab" data-bs-toggle="tab" data-bs-target="#auth-panel" type="button" role="tab" aria-controls="auth-panel" aria-selected="@(authTabActive.ToString().ToLower())">
                    Authentication
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(certificatesTabActive ? "active" : null)" id="certificates-tab" data-bs-toggle="tab" data-bs-target="#certificates-panel" type="button" role="tab" aria-controls="certificates-panel" aria-selected="@(certificatesTabActive.ToString().ToLower())">
                    Certificate Management
                </button>
            </li>
        </ul>

        <div class="tab-content pt-4" id="adminTabsContent">
            <div class="tab-pane fade @(certificatesTabActive ? "show active" : null)" id="certificates-panel" role="tabpanel" aria-labelledby="certificates-tab">
    <div class="row mt-0">
        <div class="col-12">
            <div>
                <h2>Signing Certificates</h2>
                <p class="mb-0">Manage the default certificate used to finalize signed PDFs. Users can override the default for each envelope.</p>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#uploadCertificateModal">
                    <strong>Upload PFX</strong>
                </button>
            </div>
            <table class="table table-hover" data-esign-table="overview" data-page-size="10">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Subject</th>
                        <th>Valid Until</th>
                        <th>Thumbprint</th>
                        <th data-sortable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Certificates.Any()) {
                        <tr>
                            <td colspan="5">No uploaded local certificates.</td>
                        </tr>
                    }
                    @foreach (var certificate in Model.Certificates) {
                        <tr class="@(certificate.IsActive ? "certificate-active-row" : null)">
                            <td>
                                <strong>@certificate.DisplayName</strong>
                            </td>
                            <td>@certificate.Subject</td>
                            <td>@certificate.NotAfter</td>
                            <td><code>@certificate.Thumbprint</code></td>
                            <td>
                                <div class="d-flex gap-2">
                                    @if (certificate.IsActive) {
                                        <button type="button" class="btn btn-sm btn-success" disabled aria-current="true">
                                            Default
                                        </button>
                                    }
                                    else {
                                        <form method="post" asp-page-handler="ActivateCertificate">
                                            <input type="hidden" name="certificateId" value="@certificate.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Set Default</button>
                                        </form>
                                    }
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteCertificateModal"
                                            data-certificate-id="@certificate.Id"
                                            data-certificate-name="@certificate.DisplayName">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.CertificateConfiguration.Provider == "AzureKeyVault" && !string.IsNullOrWhiteSpace(Model.CertificateConfiguration.AzureKeyVaultUri)) {
                <div class="box-frame mt-3 certificate-active-row">
                    <strong>External store</strong>
                    <p class="mb-0">
                        Azure Key Vault:
                        <code>@Model.CertificateConfiguration.AzureKeyVaultUri</code>,
                        certificate:
                        <code>@Model.CertificateConfiguration.AzureCertificateName</code>.
                    </p>
                </div>
            }
            else if (Model.Certificates.Any(certificate => certificate.IsActive)) {
                <form method="post" asp-page-handler="UseLocalPfx" class="mt-3">
                    <button type="submit" class="btn btn-sm btn-success" disabled>Local PFX Default</button>
                </form>
            }

            <div class="box mt-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h3>Azure Key Vault</h3>
                        <p class="mb-0">Use a certificate from an Azure Key Vault for finalized PDFs.</p>
                    </div>
                    <span class="badge rounded-pill bg-@(Model.CertificateConfiguration.Provider == "AzureKeyVault" ? "success" : "secondary")">
                        @(Model.CertificateConfiguration.Provider == "AzureKeyVault" ? "Active" : "Inactive")
                    </span>
                </div>
                <form method="post" asp-page-handler="ConfigureAzureKeyVault">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="AzureKeyVault.VaultUri" class="form-label"></label>
                        <input asp-for="AzureKeyVault.VaultUri" class="form-control" placeholder="https://contoso.vault.azure.net/" />
                        <span asp-validation-for="AzureKeyVault.VaultUri" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AzureKeyVault.CertificateName" class="form-label"></label>
                        <input asp-for="AzureKeyVault.CertificateName" class="form-control" />
                        <span asp-validation-for="AzureKeyVault.CertificateName" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="AzureKeyVault.UseDefaultAzureCredential" class="form-check-input" />
                        <label asp-for="AzureKeyVault.UseDefaultAzureCredential" class="form-check-label"></label>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AzureKeyVault.TenantId" class="form-label"></label>
                            <input asp-for="AzureKeyVault.TenantId" class="form-control" />
                            <span asp-validation-for="AzureKeyVault.TenantId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AzureKeyVault.ClientId" class="form-label"></label>
                            <input asp-for="AzureKeyVault.ClientId" class="form-control" />
                            <span asp-validation-for="AzureKeyVault.ClientId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Activate Azure Key Vault</button>
                        @if (Model.CertificateConfiguration.Provider == "AzureKeyVault" && Model.Certificates.Any()) {
                            <button type="submit" class="btn btn-outline-secondary" asp-page-handler="UseLocalPfx">Use Local PFX</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteCertificateModal" tabindex="-1" aria-labelledby="deleteCertificateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-modal-content">
                <form method="post" asp-page-handler="DeleteCertificate">
                    <div class="modal-header app-modal-header">
                        <div class="app-modal-icon text-danger" aria-hidden="true">
                            <i class="bi bi-trash3"></i>
                        </div>
                        <h5 class="modal-title" id="deleteCertificateModalLabel">Delete Certificate</h5>
                        <p>
                            This removes the uploaded PFX certificate from local certificate management.
                        </p>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body app-modal-body">
                        <input type="hidden" id="deleteCertificateId" name="certificateId" />
                        <div class="auth-alert mb-0" role="alert">
                            Delete <strong id="deleteCertificateName">this certificate</strong>?
                        </div>
                    </div>
                    <div class="modal-footer app-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete Certificate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="uploadCertificateModal" tabindex="-1" aria-labelledby="uploadCertificateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-modal-content">
                <form id="uploadCertificateForm" method="post" asp-page-handler="UploadCertificate" enctype="multipart/form-data">
                    <div class="modal-header app-modal-header">
                        <div class="app-modal-icon" aria-hidden="true">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h5 class="modal-title" id="uploadCertificateModalLabel">Upload PFX</h5>
                        <p>Add a local signing certificate for finalized PDFs.</p>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body app-modal-body">
                        <div asp-validation-summary="ModelOnly" class="auth-alert"></div>
                        <div id="uploadCertificateError" class="auth-alert d-none" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="UploadCertificate.DisplayName" class="form-label"></label>
                            <input asp-for="UploadCertificate.DisplayName" class="form-control" />
                            <span asp-validation-for="UploadCertificate.DisplayName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UploadCertificate.File" class="form-label"></label>
                            <input asp-for="UploadCertificate.File" class="form-control" accept=".pfx" />
                            <span asp-validation-for="UploadCertificate.File" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UploadCertificate.Password" class="form-label"></label>
                            <input asp-for="UploadCertificate.Password" class="form-control" />
                            <span asp-validation-for="UploadCertificate.Password" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer app-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning"><strong>Upload Certificate</strong></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

            </div>

            <div class="tab-pane fade @(emailTabActive ? "show active" : null)" id="email-panel" role="tabpanel" aria-labelledby="email-tab">
    <div class="row mt-0">
        <div class="col-12">
            <h2>E-Mail Settings</h2>
            <p class="mb-0">Manage SMTP delivery and the HTML templates used by signature workflows.</p>
        </div>
    </div>

    <div class="admin-inner-tabs mt-4">
        <ul class="nav nav-tabs" id="emailSettingsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Request.Query.ContainsKey("emailTemplate") ? null : "active")" id="smtp-settings-tab" data-bs-toggle="tab" data-bs-target="#smtp-settings-panel" type="button" role="tab" aria-controls="smtp-settings-panel" aria-selected="@((!Request.Query.ContainsKey("emailTemplate")).ToString().ToLower())">
                    SMTP
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Request.Query.ContainsKey("emailTemplate") ? "active" : null)" id="email-templates-tab" data-bs-toggle="tab" data-bs-target="#email-templates-panel" type="button" role="tab" aria-controls="email-templates-panel" aria-selected="@(Request.Query.ContainsKey("emailTemplate").ToString().ToLower())">
                    HTML Templates
                </button>
            </li>
        </ul>

        <div class="tab-content pt-4" id="emailSettingsTabsContent">
            <div class="tab-pane fade @(Request.Query.ContainsKey("emailTemplate") ? null : "show active")" id="smtp-settings-panel" role="tabpanel" aria-labelledby="smtp-settings-tab">
            <div class="box">
                <h3>SMTP</h3>
                <form method="post" asp-page-handler="SaveEmailSettings" autocomplete="off">
                    <input type="hidden" asp-for="EmailTemplate.FileName" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="EmailSettings.Server" class="form-label"></label>
                        <input asp-for="EmailSettings.Server" class="form-control" />
                        <span asp-validation-for="EmailSettings.Server" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSettings.Port" class="form-label"></label>
                        <input asp-for="EmailSettings.Port" class="form-control" />
                        <span asp-validation-for="EmailSettings.Port" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSettings.Username" class="form-label"></label>
                        <input asp-for="EmailSettings.Username" class="form-control" />
                        <span asp-validation-for="EmailSettings.Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSettings.Password" class="form-label"></label>
                        <input asp-for="EmailSettings.Password" class="form-control" placeholder="@(Model.EmailSettings.HasPassword ? "Stored password is kept" : null)" />
                        <div class="form-text">
                            @(Model.EmailSettings.PasswordRequiresReset ? "The stored password cannot be decrypted. Enter it again to re-encrypt it." : Model.EmailSettings.HasPassword ? "Leave blank to keep the stored encrypted password." : "Enter the SMTP password to store it encrypted.")
                        </div>
                        <span asp-validation-for="EmailSettings.Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSettings.From" class="form-label"></label>
                        <input asp-for="EmailSettings.From" class="form-control" />
                        <span asp-validation-for="EmailSettings.From" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSettings.Bcc" class="form-label"></label>
                        <input asp-for="EmailSettings.Bcc" class="form-control" placeholder="admin@example.com; audit@example.com" />
                        <div class="form-text">Separate multiple hidden copy recipients with commas or semicolons.</div>
                        <span asp-validation-for="EmailSettings.Bcc" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save E-Mail Settings</button>
                </form>
            </div>
            </div>
            <div class="tab-pane fade @(Request.Query.ContainsKey("emailTemplate") ? "show active" : null)" id="email-templates-panel" role="tabpanel" aria-labelledby="email-templates-tab">
            <div class="box">
                <div class="mb-3">
                    <div>
                        <h3>HTML Templates</h3>
                        <p class="mb-0">Edit the shared e-mail layout and the child content templates. Keep placeholder tokens intact.</p>
                    </div>
                </div>

                @if (!Model.EmailTemplates.Any()) {
                    <div class="alert alert-warning mb-0" role="alert">No HTML e-mail templates were found.</div>
                }
                else {
                    var layoutTemplate = Model.EmailTemplates.FirstOrDefault(template =>
                        string.Equals(template.FileName, "email-layout.html", StringComparison.OrdinalIgnoreCase));
                    var contentTemplates = Model.EmailTemplates.Where(template =>
                        !string.Equals(template.FileName, "email-layout.html", StringComparison.OrdinalIgnoreCase));

                    @if (layoutTemplate != null) {
                        <div class="mb-3">
                            <div class="form-label">Shared layout</div>
                            <a class="btn btn-sm @(layoutTemplate.FileName == Model.SelectedEmailTemplate.FileName ? "btn-primary" : "btn-outline-secondary")"
                               asp-page="/Admin/Index"
                               asp-route-emailTemplate="@layoutTemplate.FileName">
                                @layoutTemplate.FileName
                            </a>
                        </div>
                    }

                    <div class="mb-3">
                        <div class="form-label">Content templates</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var template in contentTemplates) {
                                <a class="btn btn-sm @(template.FileName == Model.SelectedEmailTemplate.FileName ? "btn-primary" : "btn-outline-secondary")"
                                   asp-page="/Admin/Index"
                                   asp-route-emailTemplate="@template.FileName">
                                    @template.FileName
                                </a>
                            }
                        </div>
                    </div>

                    <form method="post" asp-page-handler="SaveEmailTemplate">
                        <input type="hidden" asp-for="EmailTemplate.FileName" />
                        <div class="email-template-dynamic-box" id="email-template-dynamic">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <h4>Selected template: @Model.SelectedEmailTemplate.FileName</h4>
                                    <p class="mb-0">These subject, preview text, and HTML contents belong only to this selected template and must be saved separately from SMTP settings.</p>
                                </div>
                                <span class="badge bg-info text-dark">Template-specific</span>
                            </div>

                            <div class="mb-3">
                                <div class="form-label">Available placeholders:</div>
                                @if (Model.SelectedEmailTemplate.Placeholders.Any()) {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var placeholder in Model.SelectedEmailTemplate.Placeholders) {
                                            <span class="badge bg-secondary">@placeholder</span>
                                        }
                                    </div>
                                }
                                else {
                                    <div class="form-text">This template does not define any placeholders.</div>
                                }
                            </div>

                            <div class="mb-3">
                                <label asp-for="EmailTemplate.Subject" class="form-label"></label>
                                <input asp-for="EmailTemplate.Subject" class="form-control" />
                                <div class="form-text">This is used as the message subject and the title in the shared e-mail layout.</div>
                                <span asp-validation-for="EmailTemplate.Subject" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="EmailTemplate.Preheader" class="form-label"></label>
                                <input asp-for="EmailTemplate.Preheader" class="form-control" />
                                <div class="form-text">Short preview text shown by many e-mail clients.</div>
                                <span asp-validation-for="EmailTemplate.Preheader" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="EmailTemplate.Html" class="form-label">HTML</label>
                                <textarea asp-for="EmailTemplate.Html" class="form-control email-template-editor" rows="18" spellcheck="false"></textarea>
                                <span asp-validation-for="EmailTemplate.Html" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">Save Selected Template</button>
                        </div>
                    </form>
                }
            </div>
            </div>
        </div>
    </div>
            </div>

            <div class="tab-pane fade @(authTabActive ? "show active" : null)" id="auth-panel" role="tabpanel" aria-labelledby="auth-tab">
    <div class="row mt-0">
        <div class="col-12">
            <h2>Authentication</h2>
            <p class="mb-0">Configure local login companions, enterprise SSO, external bearer tokens, and local OAuth API clients.</p>
        </div>
    </div>

    <form id="authenticationSettingsForm" method="post" asp-page-handler="SaveAuthenticationSettings" autocomplete="off" class="mt-4" data-auth-autosave="true">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div id="authenticationSettingsAutosaveStatus" class="form-text mb-3" role="status" aria-live="polite"></div>

        <div class="box mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h3>Signer Accounts</h3>
                    <p class="mb-0">Offer signers a restricted account after signing so they can access their completed documents later.</p>
                </div>
                <span class="badge rounded-pill bg-@(Model.AuthenticationSettings.SignerAccountCreationEnabled ? "success" : "secondary")"
                      data-auth-status-badge-for="AuthenticationSettings_SignerAccountCreationEnabled">
                    @(Model.AuthenticationSettings.SignerAccountCreationEnabled ? "Enabled" : "Disabled")
                </span>
            </div>
            <div class="form-check form-switch mb-0">
                <input asp-for="AuthenticationSettings.SignerAccountCreationEnabled" class="form-check-input" role="switch" />
                <label asp-for="AuthenticationSettings.SignerAccountCreationEnabled" class="form-check-label"></label>
            </div>
        </div>

        <div class="box mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h3>Local OAuth Token Endpoint</h3>
                    <p class="mb-0">Issue first-party client credentials tokens from <code>/api/v1/oauth/token</code> for integrations without an external identity provider.</p>
                </div>
                <span class="badge rounded-pill bg-@(Model.AuthenticationSettings.LocalOAuthEnabled ? "success" : "secondary")"
                      data-auth-status-badge-for="AuthenticationSettings_LocalOAuthEnabled">
                    @(Model.AuthenticationSettings.LocalOAuthEnabled ? "Enabled" : "Disabled")
                </span>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="AuthenticationSettings.LocalOAuthEnabled" class="form-check-input" role="switch" />
                <label asp-for="AuthenticationSettings.LocalOAuthEnabled" class="form-check-label"></label>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.LocalOAuthIssuer" class="form-label"></label>
                    <input asp-for="AuthenticationSettings.LocalOAuthIssuer" class="form-control" placeholder="SignFabric" />
                    <span asp-validation-for="AuthenticationSettings.LocalOAuthIssuer" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.LocalOAuthAudience" class="form-label"></label>
                    <input asp-for="AuthenticationSettings.LocalOAuthAudience" class="form-control" placeholder="signfabric-api" />
                    <span asp-validation-for="AuthenticationSettings.LocalOAuthAudience" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.LocalOAuthSigningKey" class="form-label"></label>
                    <input asp-for="AuthenticationSettings.LocalOAuthSigningKey"
                           class="form-control"
                           type="text"
                           autocomplete="new-password"
                           autocorrect="off"
                           autocapitalize="off"
                           spellcheck="false"
                           data-auth-manual-secret="true"
                           data-lpignore="true"
                           data-1p-ignore="true"
                           data-form-type="other"
                           placeholder="@(Model.AuthenticationSettings.LocalOAuthHasSigningKey ? "Stored signing key is kept" : "At least 32 characters")" />
                    <div class="form-text">
                        @(Model.AuthenticationSettings.LocalOAuthHasSigningKey ? "Leave blank to keep the current signing key." : "Use a high-entropy key of at least 32 characters.")
                    </div>
                    <span asp-validation-for="AuthenticationSettings.LocalOAuthSigningKey" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.LocalOAuthAccessTokenMinutes" class="form-label"></label>
                    <input asp-for="AuthenticationSettings.LocalOAuthAccessTokenMinutes" class="form-control" />
                    <span asp-validation-for="AuthenticationSettings.LocalOAuthAccessTokenMinutes" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-3 mt-2 mb-3">
                <h4 class="mb-0">API Clients</h4>
                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createApiClientModal">
                    <i class="bi bi-key"></i>
                    <strong>Create API Client</strong>
                </button>
            </div>
            @if (Model.AuthenticationConfiguration.LocalOAuth.Clients.Any()) {
                <table class="table table-hover" data-esign-table="overview" data-page-size="10">
                    <thead>
                        <tr>
                            <th>Client ID</th>
                            <th>Name</th>
                            <th>User ID</th>
                            <th>Scopes</th>
                            <th data-sortable="false">Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model.AuthenticationConfiguration.LocalOAuth.Clients) {
                            <tr>
                                <td><code>@client.ClientId</code></td>
                                <td>@(!string.IsNullOrWhiteSpace(client.DisplayName) ? client.DisplayName : "-")</td>
                                <td><code>@client.UserId</code></td>
                                <td>@string.Join(", ", client.Scopes ?? new List<string>())</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteApiClientModal"
                                            data-client-id="@client.ClientId"
                                            data-client-name="@(!string.IsNullOrWhiteSpace(client.DisplayName) ? client.DisplayName : client.ClientId)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else {
                <div class="alert alert-info" role="alert">No local OAuth API clients have been created yet.</div>
            }
        </div>

        <div class="box mb-4">
