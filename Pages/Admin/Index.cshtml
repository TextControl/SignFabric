@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var generateButton = document.querySelector("[data-esign-action='generate-temporary-password']");
            var passwordInput = document.getElementById("InviteUser_TemporaryPassword");
            var uploadForm = document.getElementById("uploadCertificateForm");
            var uploadError = document.getElementById("uploadCertificateError");
            var deleteCertificateModal = document.getElementById("deleteCertificateModal");
            var deleteUserModal = document.getElementById("deleteUserModal");
            var deleteApiClientModal = document.getElementById("deleteApiClientModal");
            var authenticationSettingsForm = document.getElementById("authenticationSettingsForm");
            var authenticationSettingsStatus = document.getElementById("authenticationSettingsAutosaveStatus");

            function initAuthenticationSettingsAutosave() {
                if (!authenticationSettingsForm || !authenticationSettingsStatus) {
                    return;
                }

                var debounceTimer;
                var pendingSave = false;
                var saveInProgress = false;
                var manualSecretFields = authenticationSettingsForm.querySelectorAll("[data-auth-manual-secret='true']");

                function setStatus(message, state) {
                    authenticationSettingsStatus.textContent = message || "";
                    authenticationSettingsStatus.classList.remove("text-success", "text-danger", "text-muted");
                    if (state) {
                        authenticationSettingsStatus.classList.add(state);
                    }
                }

                async function save() {
                    if (saveInProgress) {
                        pendingSave = true;
                        return;
                    }

                    saveInProgress = true;
                    pendingSave = false;
                    setStatus("Saving authentication settings...", "text-muted");

                    try {
                        var formData = new FormData(authenticationSettingsForm);
                        manualSecretFields.forEach(function (field) {
                            if (field.dataset.userEdited !== "true") {
                                formData.delete(field.name);
                            }
                        });

                        var response = await fetch(authenticationSettingsForm.action, {
                            method: "POST",
                            body: formData,
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        });

                        if (!response.ok) {
                            throw new Error("Save failed.");
                        }

                        setStatus("Authentication settings saved.", "text-success");
                    }
                    catch {
                        setStatus("Authentication settings could not be saved.", "text-danger");
                    }
                    finally {
                        saveInProgress = false;
                        if (pendingSave) {
                            save();
                        }
                    }
                }

                function scheduleSave(immediate) {
                    window.clearTimeout(debounceTimer);
                    if (immediate) {
                        save();
                        return;
                    }

                    debounceTimer = window.setTimeout(save, 600);
                }

                function updateStatusBadge(field) {
                    var badge = document.querySelector("[data-auth-status-badge-for='" + field.id + "']");
                    if (!badge || field.type !== "checkbox") {
                        return;
                    }

                    badge.textContent = field.checked ? "Enabled" : "Disabled";
                    badge.classList.toggle("bg-success", field.checked);
                    badge.classList.toggle("bg-secondary", !field.checked);
                }

                authenticationSettingsForm.addEventListener("submit", function (event) {
                    event.preventDefault();
                    scheduleSave(true);
                });

                authenticationSettingsForm.querySelectorAll("input, textarea, select").forEach(function (field) {
                    if (field.type === "hidden") {
                        return;
                    }

                    if (field.dataset.authManualSecret === "true") {
                        field.addEventListener("keydown", function () {
                            field.dataset.userEdited = "true";
                        });
                        field.addEventListener("paste", function () {
                            field.dataset.userEdited = "true";
                        });
                    }

                    if (field.type === "checkbox" || field.type === "radio" || field.tagName === "SELECT") {
                        field.addEventListener("change", function () {
                            updateStatusBadge(field);
                            scheduleSave(true);
                        });
                        return;
                    }

                    field.addEventListener("change", function () {
                        scheduleSave(true);
                    });
                    field.addEventListener("blur", function () {
                        scheduleSave(true);
                    });
                });
            }

            initAuthenticationSettingsAutosave();

            if (deleteCertificateModal) {
                deleteCertificateModal.addEventListener("show.bs.modal", function (event) {
                    var button = event.relatedTarget;
                    var certificateId = button ? button.getAttribute("data-certificate-id") : "";
                    var certificateName = button ? button.getAttribute("data-certificate-name") : "";
                    var certificateIdInput = document.getElementById("deleteCertificateId");
                    var certificateNameElement = document.getElementById("deleteCertificateName");

                    if (certificateIdInput) {
                        certificateIdInput.value = certificateId || "";
                    }

                    if (certificateNameElement) {
                        certificateNameElement.textContent = certificateName || "this certificate";
                    }
                });
            }

            if (deleteUserModal) {
                deleteUserModal.addEventListener("show.bs.modal", function (event) {
                    var button = event.relatedTarget;
                    var userId = button ? button.getAttribute("data-user-id") : "";
                    var userEmail = button ? button.getAttribute("data-user-email") : "";
                    var userIdInput = document.getElementById("deleteUserId");
                    var userEmailElement = document.getElementById("deleteUserEmail");

                    if (userIdInput) {
                        userIdInput.value = userId || "";
                    }

                    if (userEmailElement) {
                        userEmailElement.textContent = userEmail || "this user";
                    }
                });
            }

            if (deleteApiClientModal) {
                deleteApiClientModal.addEventListener("show.bs.modal", function (event) {
                    var button = event.relatedTarget;
                    var clientId = button ? button.getAttribute("data-client-id") : "";
                    var clientName = button ? button.getAttribute("data-client-name") : "";
                    var clientIdInput = document.getElementById("deleteApiClientId");
                    var clientNameElement = document.getElementById("deleteApiClientName");

                    if (clientIdInput) {
                        clientIdInput.value = clientId || "";
                    }

                    if (clientNameElement) {
                        clientNameElement.textContent = clientName || "this API client";
                    }
                });
            }

            if (uploadForm && uploadError) {
                uploadForm.addEventListener("submit", async function (event) {
                    event.preventDefault();

                    uploadError.classList.add("d-none");
                    uploadError.textContent = "";

                    var submitButton = uploadForm.querySelector("button[type='submit']");
                    if (submitButton) {
                        submitButton.disabled = true;
                    }

                    try {
                        var response = await fetch(uploadForm.action, {
                            method: "POST",
                            body: new FormData(uploadForm),
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        });

                        var result = await response.json();
                        if (response.ok && result.success) {
                            window.location.href = result.redirectUrl || window.location.href;
                            return;
                        }

                        var errors = result.errors && result.errors.length
                            ? result.errors
                            : ["The certificate could not be uploaded."];

                        errors.forEach(function (error) {
                            var item = document.createElement("div");
                            item.textContent = error;
                            uploadError.appendChild(item);
                        });
                        uploadError.classList.remove("d-none");
                    }
                    catch {
                        uploadError.textContent = "The certificate could not be uploaded.";
                        uploadError.classList.remove("d-none");
                    }
                    finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                        }
                    }
                });
            }

            if (!generateButton || !passwordInput) {
                return;
            }

            function pick(characters) {
                var values = new Uint32Array(1);
                window.crypto.getRandomValues(values);
                return characters[values[0] % characters.length];
            }

            function shuffle(values) {
                for (var index = values.length - 1; index > 0; index--) {
                    var random = new Uint32Array(1);
                    window.crypto.getRandomValues(random);
                    var swapIndex = random[0] % (index + 1);
                    var value = values[index];
                    values[index] = values[swapIndex];
                    values[swapIndex] = value;
                }

                return values;
            }

            function generatePassword() {
                var lower = "abcdefghijkmnopqrstuvwxyz";
                var upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
                var digits = "23456789";
                var symbols = "!$%";
                var all = lower + upper + digits + symbols;
                var password = [
                    pick(lower),
                    pick(upper),
                    pick(digits),
                    pick(symbols)
                ];

                while (password.length < 12) {
                    password.push(pick(all));
                }

                return shuffle(password).join("");
            }

            generateButton.addEventListener("click", function () {
                passwordInput.value = generatePassword();
                passwordInput.focus();
                passwordInput.select();
            });
        });
    </script>
