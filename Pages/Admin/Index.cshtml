                <span asp-validation-for="AuthenticationSettings.OpenIdConnectAuthority" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.OpenIdConnectClientId" class="form-label"></label>
                    <input asp-for="AuthenticationSettings.OpenIdConnectClientId" class="form-control" />
                    <span asp-validation-for="AuthenticationSettings.OpenIdConnectClientId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.OpenIdConnectClientSecret" class="form-label"></label>
