                    <div class="form-text">
                        @(Model.AuthenticationSettings.OpenIdConnectHasClientSecret ? "Leave blank to keep the current client secret." : "Enter the client secret. Store production secrets outside committed appsettings.")
                    </div>
                    <span asp-validation-for="AuthenticationSettings.OpenIdConnectClientSecret" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.OpenIdConnectCallbackPath" class="form-label"></label>
                    <input asp-for="AuthenticationSettings.OpenIdConnectCallbackPath" class="form-control" placeholder="/signin-oidc" />
                    <span asp-validation-for="AuthenticationSettings.OpenIdConnectCallbackPath" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AuthenticationSettings.OpenIdConnectSignedOutCallbackPath" class="form-label"></label>
