                                <input id="createdLocalOAuthClientSecret" class="form-control" value="@Model.CreatedLocalOAuthClientSecret" readonly />
                                <button type="button" class="btn btn-outline-secondary" data-esign-action="copy-link" data-target="createdLocalOAuthClientSecret" aria-label="Copy client secret">
