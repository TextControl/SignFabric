@page "/templates/details/{id}"
@model SignFabric.Pages.Templates.DetailsModel

@{
    ViewData["Title"] = "Template Summary";
}

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="liveToast" class="toast hide text-white bg-success" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <i class="bi bi-clipboard-check" aria-hidden="true"></i>&nbsp;
            <strong class="me-auto">Text Control eSign</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div id="liveToastMessage" class="toast-body">

        </div>
    </div>
</div>

<div id="editor"></div>

<section id="home" class="container section">

    <div class="row">

        <div class="col-md-12">

            <a href="/templates" class="btn btn-warning mb-3"><strong>Back</strong></a>

            <div class="d-flex flex-wrap align-items-center gap-3">
                <h2 class="mb-0">Template: <strong>@Model.Template.Name</strong></h2>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#renameTemplateModal">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    Rename
                </button>
            </div>

            <a data-esign-action="load-template-editor" data-template-id="@Model.Template.TemplateID" class="mt-5 btn btn-success"><strong>Edit Template</strong></a>

        </div>
    </div>

    <div class="row mt-5">

        <div class="col-md-3 d-none d-md-block box box-row">
            <p>
                Document name<br />
                <strong>@Model.Template.Name</strong>
            </p>
            <p>
                <img class="img-fluid thumbnail-image" src="data:image/svg+xml;base64,@Model.ThumbnailSvg" />
            </p>
            <p>
                Created<br />
                <strong>@Model.Template.Created</strong>
            </p>
        </div>

        <div class="col-md-5">
            <h2>Create an Instance</h2>

            <h5>Fill out the contained merge fields to create an instance of the template.</h5>
            
            <p class="mb-3">The resulting document can be used to request a signature.</p>

            @if (!Model.CanRequestSignatures) {
                <div class="alert alert-warning certificate-required-alert" role="alert">
                    <strong>A signing certificate is required to request signatures.</strong>
                    <p class="mb-0 mt-2">Upload and activate a local PFX certificate or configure Azure Key Vault in the admin portal before creating an envelope from this template.</p>
                    @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                        <a href="/admin" class="btn btn-warning mt-3"><strong>Open Admin Portal</strong></a>
                    }
                </div>
                <button type="button" class="btn btn-outline-secondary" disabled>Create Instance</button>
            }
            else {
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="mergefields-tab" data-bs-toggle="tab" data-bs-target="#mergefields" type="button" role="tab" aria-controls="mergefields" aria-selected="true">Merge Fields</button>
                    </li>
                </ul>
                <div class="tab-content mt-4" id="myTabContent">
                    <div class="tab-pane fade show active" id="mergefields" role="tabpanel" aria-labelledby="mergefields-tab">

                        <div class="mt-3 waitstate">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>

                        <div id="tx-fields" class="mt-2">

                        </div>
                    </div>
                </div>
            }


        </div>

    </div>
</section>

<div class="modal fade" id="renameTemplateModal" tabindex="-1" aria-labelledby="renameTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-modal-content">
            <form method="post" asp-page-handler="Rename">
                <div class="modal-header app-modal-header">
                    <div class="app-modal-icon" aria-hidden="true">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <h5 class="modal-title" id="renameTemplateModalLabel">Rename Template</h5>
                    <p>Update the document name shown in the template overview.</p>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body app-modal-body">
                    <label asp-for="RenameTemplate.Name" class="form-label">Document name</label>
                    <input asp-for="RenameTemplate.Name" class="form-control" />
                    <span asp-validation-for="RenameTemplate.Name" class="text-danger"></span>
                </div>
                <div class="modal-footer app-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><strong>Save Name</strong></button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CanRequestSignatures) {
    <div data-esign-init="template-details" data-template-id="@Model.Template.TemplateID"></div>
}
