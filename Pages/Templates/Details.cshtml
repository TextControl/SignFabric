@page "/templates/details/{id}"
@model SignFabric.Pages.Templates.DetailsModel

@{
    ViewData["Title"] = "Template Summary";
}

<div id="editor"></div>

<section id="home" class="container section">

    <div class="mb-3">
        <a asp-page="/Templates/Index" class="btn btn-light envelope-summary-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back
        </a>
    </div>

    <div class="envelope-summary-panel">
        <div class="envelope-summary-preview d-none d-lg-flex">
            <img id="templateThumbnail" class="envelope-summary-thumbnail" src="data:image/svg+xml;base64,@Model.ThumbnailSvg" alt="Template preview" />
        </div>

        <div class="envelope-summary-content">
            <div class="envelope-summary-header">
                <div>
                    <h1 id="templateTitle">@Model.Template.Name</h1>
                    <p>Reusable document template</p>
                </div>
                <span class="template-summary-pill">
                    <i class="bi bi-file-earmark-richtext" aria-hidden="true"></i>
                    Template
                </span>
            </div>

            <dl class="envelope-summary-meta">
                <div>
                    <dt>Template ID</dt>
                    <dd>@Model.Template.TemplateID</dd>
                </div>
                <div>
                    <dt>Created</dt>
                    <dd>@Model.Template.Created</dd>
                </div>
            </dl>

            <div class="envelope-summary-actions">
                <a data-esign-action="load-template-editor" data-template-id="@Model.Template.TemplateID" class="btn btn-success">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    Edit Template
                </a>
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#renameTemplateModal">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                    Rename
                </button>
            </div>
        </div>
    </div>

    <div class="template-instance-section">
        <div class="template-instance-header">
            <div>
                <h2>Create an Instance</h2>
                <p>Fill the template merge fields to create a document that is ready for a signature workflow.</p>
            </div>
        </div>

        <div class="template-instance-panel">
            @if (!Model.CanRequestSignatures) {
                <div class="alert alert-warning certificate-required-alert mb-0" role="alert">
                    <strong>A signing certificate is required to create an envelope.</strong>
                    <p class="mb-0 mt-2">Upload and activate a local PFX certificate or configure Azure Key Vault in the admin portal before creating a signature request from this template. Contract creation remains available.</p>
                    @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                        <a href="/admin" class="btn btn-warning mt-3"><strong>Open Admin Portal</strong></a>
                    }
                </div>
            }

            <div class="template-instance-form">
                <div class="mt-3 waitstate">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <div id="tx-fields" class="mt-2"></div>
            </div>
        </div>
    </div>

</section>

<div class="modal fade" id="renameTemplateModal" tabindex="-1" aria-labelledby="renameTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-modal-content">
            <form method="post" asp-page-handler="Rename">
                <div class="modal-header app-modal-header">
                    <div class="app-modal-icon" aria-hidden="true">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <h5 class="modal-title" id="renameTemplateModalLabel">Rename Template</h5>
                    <p>Update the document name shown in the template overview.</p>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body app-modal-body">
                    <label asp-for="RenameTemplate.Name" class="form-label">Document name</label>
                    <input asp-for="RenameTemplate.Name" class="form-control" />
                    <span asp-validation-for="RenameTemplate.Name" class="text-danger"></span>
                </div>
                <div class="modal-footer app-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><strong>Save Name</strong></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div data-esign-init="template-details" data-template-id="@Model.Template.TemplateID" data-can-request-signatures="@Model.CanRequestSignatures.ToString().ToLowerInvariant()"></div>
