@page "/templates/edit/{id}"
@model SignFabric.Pages.Templates.EditModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<LiteDB.Identity.Models.LiteDbUser> SignInManager

@{
    ViewData["Title"] = "Edit Template";
}

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 5">
    <div id="liveToast" class="toast hide text-white bg-success" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <i class="bi bi-clipboard-check" aria-hidden="true"></i>&nbsp;
            <strong class="me-auto">Text Control eSign</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div id="liveToastMessage" class="toast-body"></div>
    </div>
</div>

<section id="home" class="container section">

    <div class="row">
        <div class="col-md-12">
            <a href="/templates" class="btn btn-warning mb-3"><strong>Back</strong></a>

            <h2>Template: <strong>@Model.Template.Name</strong></h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <p class="text-muted">Edit template and manage merge fields</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-2 d-none d-lg-block">
            @if (!string.IsNullOrEmpty(Model.ThumbnailSvg)) {
                <img class="img-thumbnail" src="data:image/svg+xml;base64,@Model.ThumbnailSvg" />
            }
        </div>

        <div class="col-md-10">
            <div class="box highlight">
                <h4>Template Editor</h4>

                <div class="row mt-5">
                    <div class="col-md-1 offset-1 status-border">
                        <span class="status status-active"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
                    </div>
                    <div class="col-md-8 offset-md-1 status-content">
                        <p>
                            <strong>Edit Document</strong>
                            <br />
                            Modify template content and merge fields
                        </p>

                        <form method="post" asp-page-handler="save" asp-route-id="@Model.Template.TemplateID">
                            <div class="box-frame">
                                <div class="mb-3">
                                    <label for="templateName" class="form-label">Template Name</label>
                                    <input type="text" class="form-control" id="templateName" value="@Model.Template.Name" readonly>
                                    <small class="text-muted">Template editor interface would load here</small>
                                </div>

                                <button type="submit" class="btn btn-success"><strong>Save Changes</strong></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
