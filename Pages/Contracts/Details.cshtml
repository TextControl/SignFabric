@page "/contracts/details/{id}"
@model SignFabric.Pages.Contracts.DetailsModel

@{
    ViewData["Title"] = "Contract Summary";

    byte[] octets = System.Text.Encoding.UTF8.GetBytes(Model.Contract.ContractID + ":" + Model.Contract.UserID);
    var envelope_code = Convert.ToBase64String(octets);
    var host = HttpContext.Request.Scheme + "://" + HttpContext.Request.Host;
}

<div id="editor"></div>

<section id="home" class="container section">

    <div class="mb-3">
        <a asp-page="/Contracts/Index" class="btn btn-light envelope-summary-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back
        </a>
    </div>

    <div class="envelope-summary-panel">
        <div class="envelope-summary-preview d-none d-lg-flex">
            <img class="envelope-summary-thumbnail" src="data:image/svg+xml;base64,@Model.ThumbnailSvg" alt="Contract preview" />
        </div>

        <div class="envelope-summary-content">
            <div class="envelope-summary-header">
                <div>
                    <h1>@Model.Contract.Name</h1>
                    <p>Collaboration contract overview</p>
                </div>
                <span class="envelope-status-pill contract-status-@Model.Contract.Status.ToString().ToLowerInvariant()">
                    <i class="@GetContractStatusIcon(Model.Contract.Status)" aria-hidden="true"></i>
                    @Model.Contract.Status
                </span>
            </div>

            <dl class="envelope-summary-meta">
                <div>
                    <dt>Contract ID</dt>
                    <dd>@Model.Contract.ContractID</dd>
                </div>
                <div>
                    <dt>From</dt>
                    <dd>@Model.Contract.Sender</dd>
                </div>
                <div>
                    <dt>Created</dt>
                    <dd>@Model.Contract.Created</dd>
                </div>
                <div>
                    <dt>Recipient</dt>
                    <dd>@(Model.Contract.Signer?.Email ?? "Not assigned yet")</dd>
                </div>
            </dl>

            <div class="envelope-summary-actions">
                <a href="/contracts/@Model.Contract.ContractID/download" class="btn btn-outline-success">
                    <i class="bi bi-download" aria-hidden="true"></i>
                    Download
                </a>

                @if (Model.Contract.Status == ContractStatus.Changed) {
                    <a href="/collaboration/edit/@envelope_code" class="btn btn-warning">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        Review Changes
                    </a>
                }

                @if (Model.Contract.Status == ContractStatus.Accepted) {
                    @if (Model.CanRequestSignatures) {
                        <a asp-page="/Envelopes/Create" asp-route-contractId="@envelope_code" class="btn btn-success">
                            <i class="bi bi-send" aria-hidden="true"></i>
                            Request Signature
                        </a>
                    }
                    else {
                        <button type="button" class="btn btn-outline-secondary" disabled>
                            <i class="bi bi-send" aria-hidden="true"></i>
                            Request Signature
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <div class="template-instance-section">
        <div class="template-instance-header">
            <h2>Collaboration Status</h2>
            <p>Track where this contract is in the review process and what needs to happen next.</p>
        </div>

        <div class="audit-trail-card">
            <div class="audit-trail-card-header">
                <i class="@GetContractStatusIcon(Model.Contract.Status) text-alignment" aria-hidden="true"></i> @Model.Contract.Status
            </div>
            <div class="audit-trail-card-body">
                <h5 class="audit-trail-card-title">@GetContractStatusTitle(Model.Contract)</h5>
                <p class="mb-0">@GetContractStatusText(Model.Contract)</p>

                @if (Model.Contract.Status == ContractStatus.Accepted && !Model.CanRequestSignatures) {
                    <div class="alert alert-warning certificate-required-alert mt-3 mb-0" role="alert">
                        <strong>A signing certificate is required to request signatures.</strong>
                        <p class="mb-0 mt-2">Upload and activate a local PFX certificate or configure Azure Key Vault in the admin portal before converting this contract.</p>
                        @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                            <a href="/admin" class="btn btn-warning mt-3"><strong>Open Admin Portal</strong></a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="template-instance-section">
        <div class="template-instance-header">
            <h2>Sharing</h2>
            <p>Use the review link and access code to open this contract in the collaboration workflow.</p>
        </div>

        <div class="template-instance-panel">
            <div class="contract-detail-list">
                <div>
                    <label for="signatureLink" class="form-label">Review Link</label>
                    <div class="contract-copy-row">
                        <input class="copy-link" id="signatureLink" type="text" readonly value="@host/collaboration/edit/@envelope_code" />
                        <a href="#" data-esign-action="copy-link" data-target="signatureLink" class="btn btn-light contract-copy-button" aria-label="Copy review link">
                            <i class="bi bi-copy" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <div>
                    <label for="accessCode" class="form-label">Document Access ID</label>
                    <div class="contract-copy-row">
                        <input class="copy-link" id="accessCode" type="text" readonly value="@envelope_code" />
                        <a href="#" data-esign-action="copy-link" data-target="accessCode" class="btn btn-light contract-copy-button" aria-label="Copy document access ID">
                            <i class="bi bi-copy" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

@functions {
    private static string GetContractStatusIcon(ContractStatus status) {
        return status switch {
            ContractStatus.Accepted => "bi bi-check2-circle",
            ContractStatus.Changed => "bi bi-exclamation-circle",
            ContractStatus.Sent => "bi bi-send",
            ContractStatus.Closed => "bi bi-x-circle",
            _ => "bi bi-clock"
        };
    }

    private static string GetContractStatusTitle(Contract contract) {
        return contract.Status switch {
            ContractStatus.Sent => $"Waiting for {contract.Signer?.Name ?? contract.Signer?.Email ?? "the recipient"}",
            ContractStatus.Changed => $"{contract.Signer?.Name ?? contract.Signer?.Email ?? "The recipient"} updated the document",
            ContractStatus.Accepted => $"{contract.Signer?.Name ?? contract.Signer?.Email ?? "The recipient"} accepted the document",
            ContractStatus.Closed => "Contract workflow completed",
            _ => "Contract is being prepared"
        };
    }

    private static string GetContractStatusText(Contract contract) {
        return contract.Status switch {
            ContractStatus.Sent => "The document has been sent for collaboration. You will be notified when changes are proposed or the recipient accepts it.",
            ContractStatus.Changed => "Review the proposed changes and decide whether to accept them or continue editing the contract.",
            ContractStatus.Accepted => "The collaboration review is complete. You can now turn this contract into a signature request.",
            ContractStatus.Closed => "This contract is no longer active in the collaboration workflow.",
            _ => "Upload, edit, and assign a recipient to move this contract through the review flow."
        };
    }
}
