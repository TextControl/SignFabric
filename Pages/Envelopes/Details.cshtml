@page "/envelopes/details/{id}"
@model SignFabric.Pages.Envelopes.DetailsModel

@{
    ViewData["Title"] = "Envelope Summary";

    byte[] octets = System.Text.Encoding.ASCII.GetBytes(Model.Envelope.EnvelopeID + ":" + Model.Envelope.UserID);
    var envelope_code = Convert.ToBase64String(octets);
    var host = HttpContext.Request.Scheme + "://" + HttpContext.Request.Host;
}


<div id="editor"></div>

<section id="home" class="container section">

    <div class="mb-3">
        <a asp-page="/Envelopes/Index" class="btn btn-light envelope-summary-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back
        </a>
    </div>

    <div class="envelope-summary-panel">
        <div class="envelope-summary-preview d-none d-lg-flex">
            <img class="envelope-summary-thumbnail" src="data:image/svg+xml;base64,@Model.ThumbnailSvg" alt="Document preview" />
        </div>

        <div class="envelope-summary-content">
            <div class="envelope-summary-header">
                <div>
                    <h1>@Model.Envelope.Name</h1>
                    <p>Envelope overview</p>
                </div>
                <span class="envelope-status-pill envelope-status-@Model.Envelope.Status.ToString().ToLowerInvariant()">
                    @if (Model.Envelope.Status == EnvelopeStatus.Signed) {
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    }
                    else if (Model.Envelope.Status == EnvelopeStatus.Faulted) {
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    }
                    else {
                        <i class="bi bi-clock" aria-hidden="true"></i>
                    }
                    @Model.Envelope.Status
                </span>
            </div>

            <dl class="envelope-summary-meta">
                <div>
                    <dt>Envelope ID</dt>
                    <dd>@Model.Envelope.EnvelopeID</dd>
                </div>
                <div>
                    <dt>From</dt>
                    <dd>@Model.Envelope.Sender</dd>
                </div>
            </dl>

            @if (Model.Envelope.Status == EnvelopeStatus.Faulted) {
                <div class="alert alert-danger" role="alert">
                    <strong>The final signed PDF could not be created.</strong>
                    <p class="mb-0 mt-2">
                        @(string.IsNullOrWhiteSpace(Model.Envelope.FaultMessage)
                            ? "Please review the signing certificate and signature fields, then try again."
                            : Model.Envelope.FaultMessage)
                    </p>
                </div>
            }

            <div class="envelope-summary-actions">
                @if (!Model.IsSignerAccount && (Model.Envelope.Status == EnvelopeStatus.Incomplete || Model.Envelope.Status == EnvelopeStatus.New)) {
                    <a asp-page="/Envelopes/Create" asp-route-id="@Model.Envelope.EnvelopeID" class="btn btn-success">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        Continue Preparing
                    </a>
                }

                @if (Model.Envelope.Status == EnvelopeStatus.Signed) {
                    <a target="_blank" asp-page="/Envelopes/Details" asp-page-handler="Download" asp-route-id="@Model.Envelope.EnvelopeID" class="btn btn-success">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        Download Signed PDF
                    </a>

                    @if (!Model.IsSignerAccount) {
                        <a asp-page="/Envelopes/Create" asp-route-id="@Model.Envelope.EnvelopeID" class="btn btn-outline-success">
                            <i class="bi bi-send" aria-hidden="true"></i>
                            Resend
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    @if (Model.Envelope.Status == EnvelopeStatus.Sent || Model.Envelope.Status == EnvelopeStatus.Signed || Model.Envelope.Status == EnvelopeStatus.Faulted) {

        <div class="row">
            <div class="col-md-8">

                <h2 class="mb-3 mt-5">Envelope Signing Status <i class="bi bi-pencil-square text-alignment text-success" aria-hidden="true"></i></h2>

                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Signer</th>
                            <th scope="col">E-Mail</th>
                            <th scope="col">Status</th>
                            <th scope="col">Signature</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Signer signer in Model.Envelope.Signers) {
                            <tr>
                                <td>@signer.Name</td>
                                <td>@signer.Email</td>
                                <td class="@GetSignerStatusTableClass(signer.SignerStatus)">
                                    <span class="badge rounded-pill @GetSignerStatusBadgeClass(signer.SignerStatus)">@signer.SignerStatus</span>

                                    @{
                                        var statusChanged = signer.StatusChanged?
                                            .LastOrDefault(item => item.SignerStatus == signer.SignerStatus);
                                    }

                                    @if (statusChanged != null) {
                                        <p>
                                            <small>@statusChanged.TimeStamp</small>
                                        </p>
                                    }
                                </td>
                                <td>
                                    @{
                                        var signatureImage = Model.GetSignatureImage(signer.Id);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(signatureImage)) {
                                        <img style="max-height: 40px" src="data:image/svg+xml;base64,@signatureImage" />
                                    }
                                    else if (signer.SignerStatus == SignerStatus.Signed && signer.SignatureInformation != null) {
                                        <span class="text-muted">Electronic signature</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Envelope.Status == EnvelopeStatus.Signed) {
        <partial name="Review/_AuditTrail" model="new EnvelopeAuditTrailView { Envelope = Model.Envelope }" />
    }

</section>

@functions {
    private static string GetSignerStatusTableClass(SignerStatus status) {
        return status switch {
            SignerStatus.Signed => "table-success",
            SignerStatus.Opened => "table-info",
            SignerStatus.Received => "table-warning",
            _ => "table-primary"
        };
    }

    private static string GetSignerStatusBadgeClass(SignerStatus status) {
        return status switch {
            SignerStatus.Signed => "bg-success",
            SignerStatus.Opened => "bg-info text-dark",
            SignerStatus.Received => "bg-warning text-dark",
            _ => "bg-primary"
        };
    }
}

