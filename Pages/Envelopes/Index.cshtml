@page "/envelopes"
@model SignFabric.Pages.Envelopes.IndexModel

@{
    ViewData["Title"] = "Envelope Overview";
}

<section id="home" class="container section">

    @if (Model.CanRequestSignatures) {
        <a asp-page="/New/Index" class="btn btn-warning mb-3"><strong>New Request</strong></a>
    }
    else {
        <div class="alert alert-warning certificate-required-alert" role="alert">
            <strong>A signing certificate is required to request signatures.</strong>
            <p class="mb-0 mt-2">
                Upload and activate a local PFX certificate or configure Azure Key Vault in the admin portal before creating a new signature request.
            </p>
            @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                <a href="/admin" class="btn btn-warning mt-3"><strong>Open Admin Portal</strong></a>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary mb-3" disabled>New Request</button>
    }

    <h1>Signature Requests</h1>

    <div class="row">
        <div class="col-12">
            <div>
                <table class="table table-hover mt-5" data-esign-table="overview" data-page-size="10">
                    <thead>
                        <tr>
                            <th class="align-middle" scope="col">Subject</th>
                            <th class="align-middle" scope="col">Status</th>
                            <th class="align-middle" scope="col" data-sortable="false"></th>
                            <th class="align-middle" scope="col">Created</th>
                            <th class="align-middle" scope="col" data-sortable="false"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var envelope in @Model.Envelopes) {
                            <tr>
                                <th class="align-middle" scope="row"><a asp-page="/Envelopes/Details" asp-route-id="@envelope.EnvelopeID">@envelope.Name</a></th>
                                <td class="align-middle">@envelope.Status</td>
                                <td class="align-middle">
                                    @{ if (envelope.Status == EnvelopeStatus.Sent) {
                                        <i class="bi bi-send-fill text-success" aria-hidden="true"></i>
                                    }
                                    else if (envelope.Status == EnvelopeStatus.Signed) {
                                        <i class="bi bi-check-lg text-success" aria-hidden="true"></i>
                                    }
                                    else if (envelope.Status == EnvelopeStatus.Faulted) {
                                        <i class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></i>
                                    }
                                    }
                                </td>
                                <td class="align-middle">@envelope.Created</td>
                                <td class="align-middle">
                                    <div class="btn-group">
                                        <a asp-page="/Envelopes/Details" asp-route-id="@envelope.EnvelopeID" class="btn btn-primary">Summary</a>
                                        <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="visually-hidden">Toggle Dropdown</span>
                                        </button>

                                        <ul class="dropdown-menu">
                                            @if (envelope.Status == EnvelopeStatus.Incomplete) {
                                                <li><a asp-page="/Envelopes/Create" asp-route-id="@envelope.EnvelopeID" class="dropdown-item">Continue</a></li>
                                            }
                                            @if (envelope.Status == EnvelopeStatus.Signed) {
                                                <li><a target="_blank" asp-page="/Envelopes/Details" asp-page-handler="Download" asp-route-id="@envelope.EnvelopeID" class="dropdown-item">Download</a></li>
                                            }
                                            @if (envelope.Status == EnvelopeStatus.Sent) {
                                                <li><a asp-page="/Envelopes/Create" asp-route-id="@envelope.EnvelopeID" class="dropdown-item">Resend</a></li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</section>
