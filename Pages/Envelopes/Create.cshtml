@page "/envelopes/create/{id?}"
@model SignFabric.Pages.Envelopes.CreateModel

@using Microsoft.AspNetCore.Identity
@inject SignInManager<LiteDB.Identity.Models.LiteDbUser> SignInManager
@inject UserManager<LiteDB.Identity.Models.LiteDbUser> UserManager

@{
    ViewData["Title"] = "Prepare the Signature";
}


<div id="editor"></div>

<section id="home" class="container section signature-flow-section">
    @if (!string.IsNullOrEmpty(Model.CertificateRequiredMessage)) {
        <div class="alert alert-warning certificate-required-alert" role="alert">
            <strong>A signing certificate is required to request signatures.</strong>
            <p class="mb-0 mt-2">@Model.CertificateRequiredMessage</p>
            @if (User.IsInRole(SignFabric.Application.Identity.AppRoles.Admin)) {
                <a href="/admin" class="btn btn-warning mt-3"><strong>Open Admin Portal</strong></a>
            }
        </div>
        <a href="/envelopes" class="btn btn-light">Back to Signature Requests</a>
    }
    else {
    <div class="signature-flow-card" id="processSteps">
        <div class="signature-flow-heading">
            <h1>Prepare document to request signatures</h1>
            <p>
                <strong>@Model.Envelope.Name</strong>
                <span>@Model.Envelope.EnvelopeID</span>
            </p>
        </div>

            <div class="row mt-5">
                <div class="col-md-1 offset-1 status-border status-border-checked">
                    <span class="status status-check"><i class="bi bi-send-fill" aria-hidden="true"></i></span>
                </div>
                <div class="col-md-8 offset-md-1 status-content">
                    <p><strong>Sender</strong><br />@User.Identity.Name</p>

                    @if (Model.Certificates.Any()) {
                        var selectedCertificateId = string.IsNullOrWhiteSpace(Model.Envelope.SigningCertificateId)
                            ? Model.DefaultCertificateId
                            : Model.Envelope.SigningCertificateId;

                        <div class="mb-3">
                            <label for="signingCertificateId" class="form-label">Signing Certificate</label>
                            <select id="signingCertificateId"
                                    class="form-select"
                                    data-envelope-id="@Model.Envelope.EnvelopeID">
                                @foreach (var certificate in Model.Certificates) {
                                    <option value="@certificate.Id" selected="@(certificate.Id == selectedCertificateId)">
                                        @certificate.DisplayName@(certificate.Id == Model.DefaultCertificateId ? " (Default)" : null)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    @if (UserManager.FindByNameAsync(User.Identity.Name).Result.EmailConfirmed == false) {
                        <div class="alert alert-warning" role="alert">
                            No e-mail added. By adding an e-mail, you will receive signature notifications.
                        </div>
                        <a href="/Identity/Account/Manage/AddEmail" type="button" class="btn btn-outline-warning mb-3">Add E-Mail</a>
                    }
                </div>
            </div>

            <div class="row">
                <div class="col-md-1 offset-1 status-border">
                    <span id="statusRecipient" class="status status-active"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
                </div>
                <div class="col-md-8 offset-md-1 status-content">
                    <p><strong>Recipients</strong><br />Please enter the name and the e-mail address of all signers.</p>

                    <div class="collapse show" id="collapseRecipient">
                        <div class="workflow-mode-panel" data-envelope-id="@Model.Envelope.EnvelopeID">
                            <div class="workflow-mode-header">
                                <strong>Workflow</strong>
                                <div class="btn-group workflow-mode-toggle" role="group" aria-label="Workflow type">
                                    <input type="radio" class="btn-check" name="workflowMode" id="workflowModeSimple" value="0" checked>
                                    <label class="btn btn-outline-primary" for="workflowModeSimple">Simple</label>
                                    <input type="radio" class="btn-check" name="workflowMode" id="workflowModeComplex" value="1">
                                    <label class="btn btn-outline-primary" for="workflowModeComplex">Complex</label>
                                </div>
                            </div>
                            <p class="workflow-mode-help">Simple sends all signers in parallel. Complex enables order, approvers, CC, and observers.</p>
                        </div>

                        <form autocomplete="on" id="processForm" class="needs-validation">
                            <div class="box-frame">
                                <div class="mb-3">
                                    <label for="signerName" class="form-label">Name</label>
                                    <input type="text" required placeholder="Recipient's name" class="form-control" id="signerName" aria-describedby="NameHelp">
                                    <div id="NameHelp" class="form-text">The name of the recipient.</div>
                                </div>
                                <div class="mb-3">
                                    <label for="signerEmail" class="form-label">E-mail address</label>
                                    <input type="email" required placeholder="signer@company.com" class="form-control" id="signerEmail" aria-describedby="emailHelp">
                                    <div id="emailHelp" class="form-text">We'll never share the e-mail with anyone else.</div>
                                </div>
                                <div class="form-check recipient-auth-option">
                                    <input type="checkbox" class="form-check-input" id="requireEmailOtp">
                                    <label for="requireEmailOtp" class="form-check-label">Require e-mail verification code before signing</label>
                                    <div class="form-text">Signers can also sign in with an existing account for this e-mail address.</div>
                                </div>
                                <div class="workflow-recipient-options d-none" id="workflowRecipientOptions">
                                    <div class="row g-3">
                                        <div class="col-md-7">
                                            <label for="recipientRole" class="form-label">Role</label>
                                            <select id="recipientRole" class="form-select">
                                                <option value="0">Signer</option>
                                                <option value="1">Approver</option>
                                                <option value="2">CC</option>
                                                <option value="3">Observer</option>
                                            </select>
                                        </div>
                                        <div class="col-md-5">
                                            <label for="recipientRoutingOrder" class="form-label">Order</label>
                                            <input type="number" min="1" step="1" value="1" class="form-control" id="recipientRoutingOrder">
                                        </div>
                                    </div>
                                </div>

                                <button data-esign-action="submit-recipient" data-envelope-id="@Model.Envelope.EnvelopeID" data-type="envelope" class="btn btn-warning"><strong>Add Recipient</strong></button>

                                <div id="recipientAlreadyAdded" class="alert alert-danger mt-3 collapse" role="alert">
                                    A recipient with this e-mail address has already been added.
                                </div>
                            </div>
                        </form>

                        <div>
                            <div class="list-group mt-3" id="listRecipients"></div>
                            <div class="workflow-designer d-none" id="workflowDesigner">
                                <div class="workflow-designer-header">
                                    <strong>Routing Designer</strong>
                                    <button type="button" data-esign-action="save-workflow" data-envelope-id="@Model.Envelope.EnvelopeID" class="btn btn-sm btn-outline-primary">Save Workflow</button>
                                </div>
                                <div id="workflowDesignerRows" class="workflow-designer-rows"></div>
                            </div>
                            <button id="btnConfirmRecipients" data-esign-action="confirm-recipients" data-envelope-id="@Model.Envelope.EnvelopeID" class="btn btn-warning mt-3 mb-3 disabled"><strong>Next</strong></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-1 offset-1 status-border">
                    <span id="statusSignature" class="status"><i class="bi bi-pen-fill" aria-hidden="true"></i></span>
                </div>
                <div class="col-md-8 offset-md-1 status-content">
                    <p><strong>Signature box</strong><br />Edit the document and insert signature boxes.</p>
                    <div class="collapse" id="collapseSignature">
                        <button data-esign-action="next-step" data-target="collapseSignature" class="btn btn-light mt-3 mb-3"><strong>Back</strong></button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-1 offset-1 status-border-last">
                    <span id="statusReview" class="status"><i class="bi bi-clipboard-check-fill" aria-hidden="true"></i></span>
                </div>
                <div class="col-md-8 offset-md-1 status-content">
                    <p><strong>Review and send</strong><br />Please review the details and send it to the recipient.</p>
                    <div class="collapse" id="collapseReview">
                        <p>Sender: <strong>@User.Identity.Name</strong></p>
                        <p>Recipients:</p>
                        <ol id="reviewRecipient" class="listRecipients"></ol>
                        <div id="submitButtons">
                            <button data-esign-action="next-step" data-target="collapseSignature" class="btn btn-light mt-3 mb-3"><strong>Back</strong></button>
                            <button data-esign-action="submit-envelope" data-envelope-id="@Model.Envelope.EnvelopeID" class="btn btn-warning mt-3 mb-3"><strong>Send</strong></button>
                        </div>

                        <div class="waitstate">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>

                        <div id="readyButton" class="visually-hidden">
                            <p>The envelope has been sent successfully.</p>
                            <a href="/envelopes/details/@Model.Envelope.EnvelopeID" class="btn btn-warning mt-3 mb-3"><strong>Overview</strong></a>
                        </div>
                    </div>
                </div>
            </div>
    </div>
    <div data-esign-init="envelope-create" data-envelope-id="@Model.Envelope.EnvelopeID"></div>
    }
</section>

@if (Model.Envelope != null) {
    <div class="modal fade" id="fieldAssignmentModal" tabindex="-1" aria-labelledby="fieldAssignmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-modal-content">
                <div class="modal-header app-modal-header">
                    <div class="app-modal-icon" aria-hidden="true">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <h5 class="modal-title" id="fieldAssignmentModalLabel">Assign Template Fields</h5>
                    <p>Some fields from the template are not connected to a recipient yet.</p>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body app-modal-body">
                    <div id="fieldAssignmentList" class="field-assignment-list"></div>
                </div>
                <div class="modal-footer app-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" data-esign-action="apply-field-assignments">
                        <strong>Apply Assignments</strong>
                    </button>
                </div>
            </div>
        </div>
    </div>

}
