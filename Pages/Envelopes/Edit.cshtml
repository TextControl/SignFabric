@page "/envelopes/edit/{id}"
@model SignFabric.Pages.Envelopes.EditModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<LiteDB.Identity.Models.LiteDbUser> SignInManager

@{
    ViewData["Title"] = "Edit Envelope";
}


<section id="home" class="container section">

    <div class="row">
        <div class="col-md-12">
            <a href="/envelopes/details/@Model.Envelope.EnvelopeID" class="btn btn-warning mb-3"><strong>Back</strong></a>

            <h2>Envelope: <strong>@Model.Envelope.Name</strong></h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <p class="text-muted">Edit envelope and add signature boxes</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-2 d-none d-lg-block">
            @if (!string.IsNullOrEmpty(Model.ThumbnailSvg)) {
                <img class="img-thumbnail" src="data:image/svg+xml;base64,@Model.ThumbnailSvg" />
            }
        </div>

        <div class="col-md-10">
            <div class="box highlight">
                <h4>Envelope Editor</h4>

                <div class="row mt-5">
                    <div class="col-md-1 offset-1 status-border">
                        <span class="status status-active"><i class="bi bi-pen-fill" aria-hidden="true"></i></span>
                    </div>
                    <div class="col-md-8 offset-md-1 status-content">
                        <p>
                            <strong>Add Signature Boxes</strong>
                            <br />
                            Edit document and insert signature boxes for signers
                        </p>

                        <form method="post" asp-page-handler="save" asp-route-id="@Model.Envelope.EnvelopeID">
                            <div class="box-frame">
                                <div class="mb-3">
                                    <label for="envelopeName" class="form-label">Envelope Name</label>
                                    <input type="text" class="form-control" id="envelopeName" value="@Model.Envelope.Name" readonly>
                                    <small class="text-muted">Envelope editor interface would load here</small>
                                </div>

                                <button type="submit" class="btn btn-success"><strong>Save Changes</strong></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
